# Copy to .env on the Pi and fill in. Never commit .env.

# Database password (any long random string; only used inside Docker)
DB_PASSWORD=change-me-to-a-long-random-string

# Where project files are stored: a folder on the NAS share mounted on the Pi
FILES_PATH=/mnt/nas/taddletick/files
# Where nightly database dumps go (also on the NAS)
BACKUP_PATH=/mnt/nas/taddletick/backups
BACKUP_KEEP_DAYS=30

# Your Pi's Tailscale HTTPS address + /google/callback (see DEPLOY.md, step 7)
GOOGLE_REDIRECT_URI=https://taddletick-pi.your-tailnet.ts.net/google/callback

# Seconds between Google syncs
SYNC_INTERVAL_SECONDS=300
